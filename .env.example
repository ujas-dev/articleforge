# Supabase (https://supabase.com/dashboard -> Project Settings -> API)
PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
PUBLIC_SUPABASE_ANON_KEY=<REDACTED - paste your anon key>

# Public site ORIGIN only - no repo sub-path. The /articleforge sub-path comes
# from `base` in astro.config.mjs and is appended by src/lib/site.ts.
PUBLIC_SITE_URL=https://USERNAME.github.io

# Optional: set to 1 to fail `npm run build` when a public var above is missing.
# The deploy workflow sets this so a misconfigured deploy cannot publish an
# empty site. Leave unset for offline/local builds.
# PUBLIC_ENV_STRICT=1

# Secret - set in Supabase Edge Function secrets, NEVER in this file:
# OPENAI_API_KEY=<REDACTED>
