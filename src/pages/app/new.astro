---
import Base from '../../layouts/Base.astro';
import { BUILT_IN_TEMPLATES } from '../../lib/templates';
---
<Base title="New article" noindex>
  <section class="max-w-2xl mx-auto reveal">
    <h1 class="font-display text-3xl font-bold mb-6">New article</h1>
    <form id="new-form" class="space-y-5">
      <div>
        <label for="title" class="block text-sm font-medium text-ink-300 mb-1">Title</label>
        <input id="title" name="title" required minlength="3" maxlength="160" class="w-full rounded-xl border border-ink-700 bg-ink-900/80 px-4 py-2.5 focus:border-brand-400 focus:outline-none" />
      </div>
      <div>
        <label for="keyword" class="block text-sm font-medium text-ink-300 mb-1">Target keyword</label>
        <input id="keyword" name="keyword" required minlength="2" maxlength="100" class="w-full rounded-xl border border-ink-700 bg-ink-900/80 px-4 py-2.5 focus:border-brand-400 focus:outline-none" />
      </div>
      <div>
        <label for="template" class="block text-sm font-medium text-ink-300 mb-1">Template</label>
        <select id="template" name="template" class="w-full rounded-xl border border-ink-700 bg-ink-900/80 px-4 py-2.5">
          <option value="">Blank</option>
          {BUILT_IN_TEMPLATES.map((tpl) => <option value={tpl.id}>{tpl.name}</option>)}
        </select>
      </div>
      <button id="new-submit" type="submit" class="rounded-xl bg-brand-400 hover:bg-brand-500 text-on-brand font-semibold px-5 py-2.5 transition-colors">Create draft</button>
    </form>
    <p id="new-status" class="mt-4 text-sm text-ink-500" aria-live="polite"></p>
  </section>
</Base>
<script>
  import { requireSession } from '../../lib/auth';
  import { createArticle, resolveTemplateId } from '../../lib/articles';
  import { applyTemplate } from '../../lib/templates';
  import { errorMessage } from '../../lib/errors';
  import { sitePath } from '../../lib/site';

  const form = document.getElementById('new-form') as HTMLFormElement;
  const submit = document.getElementById('new-submit') as HTMLButtonElement;
  const status = document.getElementById('new-status') as HTMLElement;

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    submit.disabled = true;
    status.textContent = 'Creating draft...';
    try {
      const session = await requireSession();
      if (!session) return;
      const fd = new FormData(form);
      const title = String(fd.get('title') ?? '').trim();
      const keyword = String(fd.get('keyword') ?? '').trim();
      const template = String(fd.get('template') ?? '');
      // The seeded public.templates row is the FK target for articles.template_id (F2).
      const templateId = await resolveTemplateId(template);
      const article = await createArticle({
        title,
        keyword,
        contentHtml: template ? applyTemplate(template, keyword) : '',
        templateId
      });
      window.location.assign(`${sitePath('/app/edit/')}?id=${encodeURIComponent(article.id)}`);
    } catch (error) {
      status.textContent = errorMessage(error);
      submit.disabled = false;
    }
  });
</script>
