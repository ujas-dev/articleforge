---
import Base from '../../layouts/Base.astro';
---
<Base title="Sign in">
  <div class="flex items-center justify-center min-h-[70vh]">
    <div class="w-full max-w-sm reveal">
      <h1 class="font-display text-3xl font-bold text-center hero-gradient mb-2">Welcome to ArticleForge</h1>
      <p class="text-center text-ink-400 mb-8">Sign in to your writing workspace.</p>
      <div class="space-y-3">
        <button data-oauth="github" class="w-full rounded-xl border border-ink-700 bg-ink-900/80 hover:bg-ink-800 px-4 py-3 font-medium transition-colors">
          Continue with GitHub
        </button>
        <button data-oauth="google" class="w-full rounded-xl border border-ink-700 bg-ink-900/80 hover:bg-ink-800 px-4 py-3 font-medium transition-colors">
          Continue with Google
        </button>
      </div>
      <form id="password-form" class="space-y-3 pt-6 mt-6 border-t border-ink-800 text-left">
        <div>
          <label for="email" class="block text-xs uppercase tracking-wide text-ink-500 mb-1">Email</label>
          <input id="email" type="email" autocomplete="email" required class="w-full rounded-xl border border-ink-700 bg-ink-900/80 px-4 py-2.5" />
        </div>
        <div>
          <label for="password" class="block text-xs uppercase tracking-wide text-ink-500 mb-1">Password</label>
          <input id="password" type="password" autocomplete="current-password" required class="w-full rounded-xl border border-ink-700 bg-ink-900/80 px-4 py-2.5" />
        </div>
        <button type="submit" class="w-full rounded-xl bg-brand-400 hover:bg-brand-500 text-on-brand font-semibold px-4 py-3 transition-colors">
          Sign in with email
        </button>
      </form>
      <p id="login-status" class="text-xs text-center text-ink-500 mt-6" aria-live="polite">Your data is scoped to your account via row-level security.</p>
    </div>
  </div>
</Base>
<script>
  import { signInGitHub, signInGoogle, signInWithPassword } from '../../lib/auth';
  import { sitePath } from '../../lib/site';
  import { errorMessage } from '../../lib/errors';

  const status = document.getElementById('login-status') as HTMLElement;

  document.querySelectorAll('[data-oauth]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const provider = (btn as HTMLElement).dataset.oauth;
      status.textContent = 'Redirecting to your identity provider...';
      const signIn = provider === 'github' ? signInGitHub() : signInGoogle();
      signIn.catch((error: unknown) => {
        status.textContent = errorMessage(error);
      });
    });
  });

  const form = document.getElementById('password-form') as HTMLFormElement | null;
  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    const email = (document.getElementById('email') as HTMLInputElement).value.trim();
    const password = (document.getElementById('password') as HTMLInputElement).value;
    status.textContent = 'Signing in...';
    void signInWithPassword(email, password)
      .then(() => {
        window.location.assign(sitePath('/app/'));
      })
      .catch((error: unknown) => {
        status.textContent = errorMessage(error);
      });
  });
</script>