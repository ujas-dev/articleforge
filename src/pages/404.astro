---
import Base from '../layouts/Base.astro';
import { sitePath } from '../lib/site';
---
<Base title="Not found" noindex>
  <section class="py-24 text-center">
    <p class="font-mono text-brand-300 tracking-widest">404</p>
    <h1 class="font-display text-4xl font-bold mt-4">This page never got forged</h1>
    <p class="text-ink-400 mt-4">The page you are looking for does not exist or is not published.</p>
    <a href={sitePath('/')} class="inline-block mt-8 rounded-xl bg-brand-400 hover:bg-brand-500 text-on-brand font-semibold px-6 py-3">Back home</a>
  </section>
</Base>
